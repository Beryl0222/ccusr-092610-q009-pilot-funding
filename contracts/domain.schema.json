{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "社区服务圈试点履约拨付账领域事件",
  "type": "object",
  "required": [
    "event_id",
    "event_type",
    "aggregate_type",
    "aggregate_id",
    "occurred_at",
    "version",
    "payload"
  ],
  "properties": {
    "event_id": {
      "type": "string",
      "minLength": 1
    },
    "event_type": {
      "type": "string",
      "enum": [
        "ROUND_OPENED",
        "TARGET_SET",
        "TARGET_REBASED",
        "CONTRACT_SIGNED",
        "OUTLET_REGISTERED",
        "MILESTONE_SUBMITTED",
        "SERVICE_VERIFIED",
        "DUPLICATE_FLAGGED",
        "DUPLICATE_RESOLVED",
        "PAYMENT_RESERVED",
        "PAYMENT_RELEASED",
        "PAYMENT_REJECTED",
        "PAYMENT_PAID",
        "ELIGIBILITY_REVOKED",
        "PAID_REVIEW_CLOSED",
        "OBSERVATION_RECORDED",
        "FEEDBACK_RECORDED"
      ]
    },
    "aggregate_type": {
      "type": "string",
      "enum": [
        "funding_round",
        "community_target",
        "service_contract",
        "service_outlet",
        "milestone_proof",
        "disbursement_case"
      ]
    },
    "aggregate_id": {
      "type": "string",
      "minLength": 1
    },
    "occurred_at": {
      "type": "string",
      "format": "date-time"
    },
    "version": {
      "type": "integer",
      "minimum": 1
    },
    "payload": {
      "type": "object"
    }
  },
  "payload_required_by_event": {
    "ROUND_OPENED": [
      "total_amount"
    ],
    "TARGET_SET": [
      "community_id",
      "period",
      "metric",
      "planned_count"
    ],
    "TARGET_REBASED": [
      "community_id",
      "period",
      "metric",
      "planned_count",
      "reason"
    ],
    "CONTRACT_SIGNED": [
      "round_id",
      "project_code",
      "operator_id",
      "segments"
    ],
    "OUTLET_REGISTERED": [
      "contract_id",
      "community_id",
      "service_category"
    ],
    "MILESTONE_SUBMITTED": [
      "contract_revision",
      "proof_ref",
      "project_code",
      "milestone_code",
      "verification_fingerprint"
    ],
    "SERVICE_VERIFIED": [
      "case_id",
      "verification_fingerprint"
    ],
    "DUPLICATE_FLAGGED": [
      "project_code",
      "case_id",
      "prior_fingerprint",
      "incoming_fingerprint"
    ],
    "DUPLICATE_RESOLVED": [
      "project_code",
      "case_id",
      "resolution"
    ],
    "PAYMENT_RESERVED": [
      "amount",
      "milestone_ref"
    ],
    "PAYMENT_RELEASED": [
      "amount",
      "milestone_ref",
      "reason"
    ],
    "PAYMENT_REJECTED": [
      "amount",
      "milestone_ref",
      "reason"
    ],
    "PAYMENT_PAID": [
      "amount",
      "milestone_ref"
    ],
    "ELIGIBILITY_REVOKED": [
      "effective_at",
      "reason"
    ],
    "PAID_REVIEW_CLOSED": [
      "outcome",
      "clawback_amount"
    ],
    "OBSERVATION_RECORDED": [
      "observed_at",
      "is_open",
      "next_check_due"
    ],
    "FEEDBACK_RECORDED": [
      "channel",
      "summary",
      "sentiment"
    ]
  },
  "additionalProperties": false
}
