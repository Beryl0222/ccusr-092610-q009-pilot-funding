{
  "$schema": "https://json-schema.org/2020-12/schema",
  "title": "社区服务圈试点履约拨付账领域事件",
  "type": "object",
  "required": [
    "event_id",
    "event_type",
    "aggregate_type",
    "aggregate_id",
    "occurred_at",
    "version",
    "actor",
    "payload"
  ],
  "properties": {
    "event_id": {
      "type": "string",
      "minLength": 1
    },
    "event_type": {
      "type": "string",
      "enum": [
        "ROUND_OPENED",
        "TARGET_PUBLISHED",
        "TARGET_REVISED",
        "CONTRACT_REGISTERED",
        "CONTRACT_REVISED",
        "PROJECT_LINKED",
        "MILESTONE_SUBMITTED",
        "EVIDENCE_ACCEPTED",
        "EVIDENCE_REJECTED",
        "DUPLICATE_FLAG_RAISED",
        "REVIEW_OPENED",
        "REVIEW_RESOLVED",
        "PAYMENT_RESERVED",
        "PAYMENT_APPROVED",
        "PAYMENT_RELEASED",
        "PAYMENT_REJECTED",
        "SERVICE_VERIFIED",
        "SERVICE_OBSERVED",
        "FEEDBACK_RECORDED",
        "ELIGIBILITY_REVOKED",
        "UNPAID_FROZEN",
        "PAID_AUDIT_OPENED",
        "BUDGET_UNCOMMITTED"
      ]
    },
    "aggregate_type": {
      "type": "string",
      "enum": [
        "funding_round",
        "community_target",
        "service_contract",
        "milestone_proof",
        "disbursement_case"
      ]
    },
    "aggregate_id": {
      "type": "string",
      "minLength": 1
    },
    "occurred_at": {
      "type": "string",
      "format": "date-time"
    },
    "version": {
      "type": "integer",
      "minimum": 1
    },
    "actor": {
      "type": "object",
      "required": ["id", "role"],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "role": {
          "type": "string",
          "enum": [
            "operator",
            "finance_reviewer",
            "community_acceptor",
            "approver",
            "system"
          ]
        }
      },
      "additionalProperties": false
    },
    "payload": {
      "type": "object"
    }
  },
  "payload_required_by_event": {
    "ROUND_OPENED": ["total_amount"],
    "TARGET_PUBLISHED": ["community_id", "service_category", "planned_outlets"],
    "TARGET_REVISED": ["community_id", "service_category", "planned_outlets", "supersedes_version"],
    "CONTRACT_REGISTERED": ["contract_id", "operator_id", "service_category", "segments"],
    "CONTRACT_REVISED": ["contract_id", "revision", "segments"],
    "PROJECT_LINKED": ["project_no", "contract_id", "community_id", "service_category"],
    "MILESTONE_SUBMITTED": ["contract_revision", "proof_ref", "evidence_kind", "project_no"],
    "EVIDENCE_ACCEPTED": ["proof_ref", "evidence_kind", "project_no"],
    "EVIDENCE_REJECTED": ["proof_ref", "reason", "project_no"],
    "DUPLICATE_FLAG_RAISED": ["project_no", "flag_type", "detail"],
    "REVIEW_OPENED": ["review_id", "project_no", "reason"],
    "REVIEW_RESOLVED": ["review_id", "project_no", "outcome"],
    "PAYMENT_RESERVED": ["amount", "milestone_ref", "segment_seq", "project_no"],
    "PAYMENT_APPROVED": ["case_id", "amount"],
    "PAYMENT_RELEASED": ["case_id", "amount"],
    "PAYMENT_REJECTED": ["case_id", "reason"],
    "SERVICE_VERIFIED": ["project_no", "open_for_service_at"],
    "SERVICE_OBSERVED": ["project_no", "observed_at", "status"],
    "FEEDBACK_RECORDED": ["project_no", "score", "content_excerpt"],
    "ELIGIBILITY_REVOKED": ["project_no", "effective_at", "reason"],
    "UNPAID_FROZEN": ["project_no", "case_ids"],
    "PAID_AUDIT_OPENED": ["project_no", "paid_total", "case_ids"],
    "BUDGET_UNCOMMITTED": ["case_ids", "amount"]
  },
  "additionalProperties": false
}
